<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/studio_canvas_dark</item>
        <item name="android:navigationBarColor">@color/studio_canvas_dark</item>
    </style>
    <style name="ReaderLight" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/studio_canvas_light</item>
        <item name="android:colorBackground">@color/studio_canvas_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/studio_canvas_light</item>
        <item name="android:navigationBarColor">@color/studio_canvas_light</item>
        <item name="android:colorAccent">@color/studio_accent_light</item>
    </style>
    <style name="ReaderDark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/studio_canvas_dark</item>
        <item name="android:colorBackground">@color/studio_canvas_dark</item>
        <item name="android:statusBarColor">@color/studio_canvas_dark</item>
        <item name="android:navigationBarColor">@color/studio_canvas_dark</item>
        <item name="android:colorAccent">@color/studio_accent_dark</item>
    </style>
    <style name="AppTheme.Light" parent="ReaderLight" />
    <style name="AppTheme.Dark" parent="ReaderDark" />
    <style name="AppTheme.Amoled" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorBackground">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:colorAccent">@color/studio_accent_dark</item>
    </style>
</resources>
